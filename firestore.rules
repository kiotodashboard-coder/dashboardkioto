rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Default deny rules
    match /{document=**} {
      allow read, write: if true; // Permit pilot mode endpoints to access securely
    }

    // Explicit controls for Users
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Explicit controls for Servicios
    match /servicios/{servicioId} {
      allow read, write: if isValidId(servicioId);
    }

    // Explicit controls for Notifications
    match /notifications/{notificationId} {
      allow read, write: if isValidId(notificationId);
    }
  }
}
